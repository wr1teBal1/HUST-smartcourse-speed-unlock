{
  "manifest_version": 3,
  "name": "SmartCourse 倍速解锁",
  "short_name": "SmartCourse 倍速",
  "version": "1.2.0",
  "description": "解除 HUST 智慧课程平台/超星泛雅视频的倍速限制：强制倍速、防重置、防检测伪装、安全上限提醒与播放恢复。",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SmartCourse 倍速解锁",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://smartcourse.hust.edu.cn/*",
        "*://*.hust.edu.cn/*",
        "*://*.chaoxing.com/*",
        "*://*.xuexitong.com/*"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["src/main-world.js"]
    },
    {
      "matches": [
        "*://smartcourse.hust.edu.cn/*",
        "*://*.hust.edu.cn/*",
        "*://*.chaoxing.com/*",
        "*://*.xuexitong.com/*"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "js": ["src/bridge.js"]
    }
  ]
}
